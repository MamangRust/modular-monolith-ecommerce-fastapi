# ============ Environment (parity with Go reference variable names) ============
# Copy to .env and adjust. .env is gitignored; secrets must not be committed.

# ---- application ----
ENV=development
SECRET_KEY=change-me-in-production
ENABLE_REFLECTION=false
PYROSCOPE_ENABLED=false
OTEL_ENABLED=true
OTEL_ENDPOINT=localhost:4317

# ---- postgres (sqlx-style pool settings) ----
DB_DRIVER=pgx
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=payment_gateway
DB_MAX_OPEN_CONNS=100
DB_MIN_IDLE_CONNS=50
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m

# ---- redis (generic keys; domain services may override REDIS_*_<SUFFIX>) ----
# Deviation from Go: Go configures Redis via `REDIS_URL` (no host/port vars);
# Python splits it into REDIS_HOST/REDIS_PORT/REDIS_PASSWORD (see parity note #16).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# One logical DB per domain (values verbatim from the Go
# `deployments/local/docker.env`). `resolve_for_service` maps `<domain>-service`
# → suffix, e.g. REDIS_DB_USER for the user service. The gateway (Go
# `REDIS_DB_APIGATEWAY`) resolves via service name "apigateway".
REDIS_DB_APIGATEWAY=19
REDIS_DB_AUTH=0
REDIS_DB_ROLE=1
REDIS_DB_USER=2
REDIS_DB_CATEGORY=3
REDIS_DB_MERCHANT=4
REDIS_DB_ORDER_ITEM=5
REDIS_DB_ORDER=6
REDIS_DB_PRODUCT=7
REDIS_DB_TRANSACTION=8
REDIS_DB_CART=9
REDIS_DB_REVIEW=10
REDIS_DB_SLIDER=11
REDIS_DB_SHIPPING_ADDRESS=12
REDIS_DB_BANNER=13
REDIS_DB_MERCHANT_AWARD=14
REDIS_DB_MERCHANT_BUSINESS=15
REDIS_DB_MERCHANT_DETAIL=16
REDIS_DB_MERCHANT_POLICY=17
REDIS_DB_REVIEW_DETAIL=18

# ---- kafka ----
KAFKA_BROKERS=localhost:9092

# ---- SMTP (only the email worker requires these) ----
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Email worker retry escalation (Go EMAIL_MAX_RETRIES / EMAIL_RETRY_BACKOFF;
# the port takes the backoff in seconds). Defaults: 5 attempts, 30s base.
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BACKOFF=30

# ---- gRPC service addresses (used by gateway + cross-domain adapters) ----
# Ports follow the authoritative Go sources (each service's cmd/main.go and
# deployments/local/docker.env): 19 domains, no payment-gateway remnants.
GRPC_AUTH_ADDR=localhost:50051
GRPC_ROLE_ADDR=localhost:50052
GRPC_USER_ADDR=localhost:50053
GRPC_CATEGORY_ADDR=localhost:50054
GRPC_MERCHANT_ADDR=localhost:50055
GRPC_ORDER_ITEM_ADDR=localhost:50056
GRPC_ORDER_ADDR=localhost:50057
GRPC_PRODUCT_ADDR=localhost:50058
GRPC_TRANSACTION_ADDR=localhost:50059
GRPC_CART_ADDR=localhost:50060
GRPC_REVIEW_ADDR=localhost:50061
GRPC_SLIDER_ADDR=localhost:50062
GRPC_SHIPPING_ADDRESS_ADDR=localhost:50063
GRPC_BANNER_ADDR=localhost:50064
GRPC_MERCHANT_AWARD_ADDR=localhost:50065
GRPC_MERCHANT_BUSINESS_ADDR=localhost:50066
GRPC_MERCHANT_DETAIL_ADDR=localhost:50067
GRPC_MERCHANT_POLICY_ADDR=localhost:50068
GRPC_REVIEW_DETAIL_ADDR=localhost:50069

# ---- REST gateway ----
GATEWAY_PORT=5000
